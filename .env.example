# Copy to .env (gitignored). Seeds are secrets: never in logs, prompts, the dashboard, or git.
NETWORK=devnet
TREASURY_SEED=            # used by scripts/topup.py only, run by a human
SPEND_SEED=               # used by scripts/setup_testnet.py only
AGENT_SEED=               # signer daemon
POLICY_SEED=              # policy service
REGISTRY_SEED=            # scripts/credentials.py
RLUSD_ISSUER=             # from tryrlusd.com; leave empty to stay in XRP
OPENROUTER_API_KEY=       # reader only; unset = deterministic extractor
OPENROUTER_MODEL=         # default anthropic/claude-sonnet-5
POLICY_URL=http://localhost:8001
DAEMON_URL=http://localhost:8002
